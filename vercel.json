{
    "headers": [
        {
            "source": "/version.json",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, must-revalidate" }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, must-revalidate" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!version\\.json|sw\\.js).*)",
            "destination": "/index.html"
        }
    ]
}
